      }
      .btn-linkedin {
        background-color: #0077b5;
        color: #fff !important;
      }
      .btn-linkedin:hover {
        background-color: #005582;
        color: #fff !important;
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(0,119,181,0.4);
      }
      .btn-upwork {
        background-color: #14a800;
        color: #fff !important;
      }
      .btn-upwork:hover {
        background-color: #108a00;
        color: #fff !important;
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(20,168,0,0.4);
      }
      .badge-experience {
        background: linear-gradient(135deg, #2b5876 0%, #4e4376 100%);
        color: #fff;
        padding: 8px 18px;
        border-radius: 20px;
        font-size: 0.95rem;
        font-weight: 500;
        display: inline-block;
        margin-bottom: 15px;
      }
      .badge-upwork {
        background: #14a800;
        color: #fff;
        padding: 4px 12px;
        border-radius: 12px;
        font-weight: bold;
        font-size: 0.85rem;
        margin-right: 6px;
      }
      .language-switch {
        font-weight: bold;
        color: #4b6cb7 !important;
        border: 1px solid #4b6cb7;
        border-radius: 15px;
        padding: 4px 12px !important;
        margin-top: 8px;
      }
      .language-switch:hover {
        background-color: #4b6cb7;
        color: #fff !important;
      }
      .client-content p {
        font-size: 0.98rem;
        line-height: 1.6;
      }
      .pricing-item-pro {
        height: 100%;
        display: flex;
        flex-direction: column;
      }
      .pricing-item-pro ul {
        flex-grow: 1;
        text-align: left;
      }
      .float-whatsapp {
        position: fixed;
        width: 60px;
        height: 60px;
        bottom: 25px;
        right: 25px;
        background-color: #25d366;
        color: #fff !important;
        border-radius: 50px;
        text-align: center;
        font-size: 34px;
        box-shadow: 0px 4px 15px rgba(37, 211, 102, 0.4);
        z-index: 99999;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        text-decoration: none !important;
      }
      .float-whatsapp:hover {
        background-color: #128c7e;
        color: #fff !important;
        transform: scale(1.1) rotate(5deg);
        box-shadow: 0px 6px 20px rgba(37, 211, 102, 0.6);
      }
      .float-lang {
        position: fixed;
        width: 54px;
        height: 54px;
        bottom: 95px;
        right: 28px;
        border-radius: 50px;
        box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.25);
        z-index: 99999;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
      }
      .float-lang:hover {
        transform: scale(1.1);
        box-shadow: 0px 6px 20px rgba(0, 0, 0, 0.35);
      }
                        .services .row, .pricing-tables .row {
        display: flex;
        flex-wrap: wrap;
      }
      .service-item, .pricing-item-pro {
        display: flex !important;
        flex-direction: column !important;
        height: 100% !important;
        min-height: 480px !important;
        padding: 35px 25px !important;
        box-sizing: border-box !important;
        overflow: hidden !important;
        background-color: #ffffff;
        position: relative !important;
        transition: all 0.35s ease !important;
      }
      .service-item:hover {
        background: #13aff0 url('assets/images/service-bg.jpg') no-repeat right top !important;
        background-size: cover !important;
        transform: translateY(-6px) !important;
        box-shadow: 0px 12px 30px rgba(19, 175, 240, 0.35) !important;
      }
      .service-item:hover h4,
      .service-item:hover p,
      .service-item:hover ul,
      .service-item:hover li,
      .service-item:hover span,
      .service-item:hover i,
      .service-item:hover a:not(.btn-social) {
        color: #ffffff !important;
      }
      .pricing-item-pro:before {
        display: block !important;
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        background-image: url(assets/images/pro-table-top.png) !important;
        background-repeat: no-repeat !important;
        background-size: contain !important;
        width: 250px !important;
        height: 170px !important;
        z-index: 1 !important;
        content: '' !important;
        opacity: 0.92 !important;
        pointer-events: none !important;
      }
      .pricing-item-pro:after {
        display: none !important;
      }
      .pricing-item-pro h4 {
        position: relative !important;
        z-index: 5 !important;
        margin-top: 10px !important;
        margin-bottom: 15px !important;
        color: #000000 !important;
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.25) !important;
        font-weight: 700 !important;
      }
      .pricing-item-pro:hover {
        background: #13aff0 !important;
        transform: translateY(-6px) !important;
        box-shadow: 0px 12px 30px rgba(19, 175, 240, 0.35) !important;
      }
      .pricing-item-pro:hover h4,
      .pricing-item-pro:hover p,
      .pricing-item-pro:hover ul,
      .pricing-item-pro:hover li,
      .pricing-item-pro:hover span,
      .pricing-item-pro:hover i,
      .pricing-item-pro:hover a:not(.btn-social) {
        color: #ffffff !important;
      }
      .pricing-item-pro p, .pricing-item-pro ul, .pricing-item-pro span {
        position: relative !important;
        z-index: 5 !important;
      }
      .service-item > p, .service-item > ul, .pricing-item-pro > ul {
        flex-grow: 1 !important;
        margin-bottom: 15px !important;
      }
      .card-wa-btn-wrap {
        margin-top: auto !important;
        padding-top: 15px !important;
        width: 100% !important;
        display: block !important;
        position: relative !important;
        z-index: 5 !important;
      }
      /* Header & Nav inline alignment */
      @media (min-width: 992px) {
        .header-area .main-nav {
          display: flex !important;
          align-items: center !important;
          justify-content: space-between !important;
          height: 90px !important;
          min-height: 80px !important;
        }
        .header-area .main-nav .logo {
          display: inline-flex !important;
          align-items: center !important;
          float: none !important;
          line-height: normal !important;
          height: 80px !important;
          margin-top: 0 !important;
          margin-bottom: 0 !important;
        }
        .header-area .main-nav .logo img.logo-icon-img {
          height: 48px !important;
          width: auto !important;
        }
        .header-area .main-nav .logo img.logo-text-img {
          height: 30px !important;
          width: auto !important;
          margin-left: -6px !important;
          margin-top: 0 !important;
        }
        .header-area .main-nav .nav {
          display: flex !important;
          align-items: center !important;
          float: none !important;
          margin-top: 0 !important;
          margin-bottom: 0 !important;
          margin-right: 0 !important;
        }
        .header-area .main-nav .nav li {
          padding-left: 5px !important;
          padding-right: 5px !important;
        }
        .header-area .main-nav .nav li a {
          font-size: 14px !important;
          padding: 6px 10px !important;
          letter-spacing: 0.3px !important;
          white-space: nowrap !important;
          height: auto !important;
          line-height: normal !important;
        }
      }
      /* Fix: template CSS hardcodes white hover/active on the 6th and last nav item
         (designed for a CTA button in the original template layout) */
      .header-area .main-nav .nav li:last-child a:hover,
      .background-header .main-nav .nav li:last-child a:hover,
      .header-area .main-nav .nav li:nth-child(6) a:hover,
      .background-header .main-nav .nav li:nth-child(6) a:hover,
      .header-area .main-nav .nav li:last-child a.active,
      .background-header .main-nav .nav li:last-child a.active {
        color: #4b8ef1 !important;
      }
      /* Fix: header used position:absolute until scrolled past the whole hero,
         so it disappeared right after scrolling and only came back much later.
         Keep it fixed at all times, with a solid background always (instead of
         transparent-until-scrolled), so page content never shows through/behind it. */
      .header-area.header-sticky {
        position: fixed !important;
        top: 0;
        left: 0;
        right: 0;
        background-color: #fff !important;
        box-shadow: 0px 5px 8px rgba(0,0,0,0.08);
      }
      .header-area.header-sticky .nav li a {
        color: #2a2a2a !important;
      }
      /* Logo: the desktop-only sizing above (min-width:992px) left the logo
         unconstrained below that, rendering at native image size on mobile/tablet. */
      .header-area .main-nav .logo img.logo-icon-img,
      .header-area .main-nav .logo img.logo-text-img {
        max-width: 100%;
        height: auto;
      }
      @media (max-width: 991px) {
        .header-area .main-nav .logo img.logo-icon-img {
          height: 40px;
          width: auto;
        }
        .header-area .main-nav .logo img.logo-text-img {
          height: 24px;
          width: auto;
          margin-left: -4px;
        }
      }
      /* Tools section: the mobile burger shows ONLY "back to home" + the tools
         nav (not the full site menu). Desktop keeps the normal site nav always,
         even on tools pages - the persistent left sidebar covers tools nav there. */
      .nav-tools-mobile {
        display: none;
      }
      .nav-category-label {
        display: none;
        padding: 10px 20px !important;
        font-size: 0.75rem !important;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #8a8a8a !important;
        font-weight: 700 !important;
        background: #f7f9fc !important;
        cursor: default;
      }
      @media (max-width: 767px) {
        header.in-tools-section .nav-standard {
          display: none !important;
        }
        header.in-tools-section .nav-tools-mobile {
          display: block !important;
        }
        header.in-tools-section .nav-tools-mobile a {
          padding-left: 20px !important;
        }
      }
    </style>
  </head>
