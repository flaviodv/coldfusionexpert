<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Preserve existing shared links while making the clean URL canonical. -->
        <rule name="Redirect homepage CFM URL to root" stopProcessing="true">
          <match url="^index\.cfm$" ignoreCase="true" />
          <action type="Redirect" url="/" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <!-- The production site does not declare index.cfm as an IIS default document. -->
        <rule name="Rewrite clean homepage URL" stopProcessing="true">
          <match url="^$" />
          <action type="Rewrite" url="index.cfm" appendQueryString="true" />
        </rule>
        <rule name="Redirect tools landing CFM URL to clean URL" stopProcessing="true">
          <match url="^tools\.cfm$" ignoreCase="true" />
          <action type="Redirect" url="/tools" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <rule name="Redirect tool CFM URLs to clean URLs" stopProcessing="true">
          <match url="^tools/([a-z0-9-]+)\.cfm$" ignoreCase="true" />
          <action type="Redirect" url="/tools/{R:1}" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <!-- The section landing page has a physical /tools directory, so it needs its own route. -->
        <rule name="Rewrite clean tools landing URL" stopProcessing="true">
          <match url="^tools/?$" ignoreCase="true" />
          <action type="Rewrite" url="tools.cfm" appendQueryString="true" />
        </rule>
        <!-- Internally route /tools/slug to the existing CFML entry point. -->
        <rule name="Rewrite clean tool URLs" stopProcessing="true">
          <match url="^tools/([a-z0-9-]+)/?$" ignoreCase="true" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="tools/{R:1}.cfm" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <mimeMap fileExtension=".geojson" mimeType="application/geo+json" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
  </system.webServer>
</configuration>
