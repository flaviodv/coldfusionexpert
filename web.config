<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Canonical protocol: production HTTP requests must not serve a duplicate
             page. Keep localhost available over HTTP for local development. -->
        <rule name="Redirect HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            <add input="{HTTP_HOST}" pattern="(^|\.)localhost(:\d+)?$" negate="true" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://coldfusionexpert.ar/{R:1}" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <rule name="Rewrite clean 404 page" stopProcessing="true">
          <match url="^404/?$" ignoreCase="true" />
          <action type="Rewrite" url="404.cfm" appendQueryString="true" />
        </rule>
        <!-- Legacy ?lan= query strings -> clean path-based language URLs (301, preserves anything already indexed). Must run before the rewrite rules below, which would otherwise just pass ?lan= through untouched. -->
        <rule name="Redirect legacy homepage lan=es to /es/" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="(^|&amp;)lan=es(&amp;|$)" />
          </conditions>
          <action type="Redirect" url="/es/" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="Redirect legacy homepage lan=en to /" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="(^|&amp;)lan=en(&amp;|$)" />
          </conditions>
          <action type="Redirect" url="/" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="Redirect legacy tools landing lan=es to /es/tools" stopProcessing="true">
          <match url="^tools/?$" ignoreCase="true" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="(^|&amp;)lan=es(&amp;|$)" />
          </conditions>
          <action type="Redirect" url="/es/tools" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="Redirect legacy tools landing lan=en to /tools" stopProcessing="true">
          <match url="^tools/?$" ignoreCase="true" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="(^|&amp;)lan=en(&amp;|$)" />
          </conditions>
          <action type="Redirect" url="/tools" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="Redirect legacy tool page lan=es to /es/tools/slug" stopProcessing="true">
          <match url="^tools/([a-z0-9-]+)/?$" ignoreCase="true" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="(^|&amp;)lan=es(&amp;|$)" />
          </conditions>
          <action type="Redirect" url="/es/tools/{R:1}" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="Redirect legacy tool page lan=en to /tools/slug" stopProcessing="true">
          <match url="^tools/([a-z0-9-]+)/?$" ignoreCase="true" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="(^|&amp;)lan=en(&amp;|$)" />
          </conditions>
          <action type="Redirect" url="/tools/{R:1}" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <!-- New path-based Spanish routes. Internally add lan=es so Application.cfc's
             existing language detection (reads url.lan) keeps working unchanged. -->
        <rule name="Rewrite clean Spanish homepage URL" stopProcessing="true">
          <match url="^es/?$" ignoreCase="true" />
          <action type="Rewrite" url="index.cfm?lan=es" appendQueryString="true" />
        </rule>
        <rule name="Rewrite clean Spanish profile URL" stopProcessing="true">
          <match url="^es/flavio-di-virgilio/?$" ignoreCase="true" />
          <action type="Rewrite" url="flavio-di-virgilio.cfm?lan=es" appendQueryString="true" />
        </rule>
        <rule name="Rewrite clean Spanish ColdFusion development URL" stopProcessing="true">
          <match url="^es/coldfusion-development/?$" ignoreCase="true" />
          <action type="Rewrite" url="coldfusion-development.cfm?lan=es" appendQueryString="true" />
        </rule>
        <rule name="Rewrite clean Spanish SEO AI readiness URL" stopProcessing="true">
          <match url="^es/seo-ai-readiness/?$" ignoreCase="true" />
          <action type="Rewrite" url="seo-ai-readiness.cfm?lan=es" appendQueryString="true" />
        </rule>
        <rule name="Rewrite clean Spanish tools landing URL" stopProcessing="true">
          <match url="^es/tools/?$" ignoreCase="true" />
          <action type="Rewrite" url="tools.cfm?lan=es" appendQueryString="true" />
        </rule>
        <rule name="Rewrite clean Spanish tool URLs" stopProcessing="true">
          <match url="^es/tools/([a-z0-9-]+)/?$" ignoreCase="true" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="tools/{R:1}.cfm?lan=es" appendQueryString="true" />
        </rule>
        <!-- Preserve existing shared links while making the clean URL canonical. -->
        <rule name="Redirect homepage CFM URL to root" stopProcessing="true">
          <match url="^index\.cfm$" ignoreCase="true" />
          <action type="Redirect" url="/" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <!-- The production site does not declare index.cfm as an IIS default document. -->
        <rule name="Rewrite clean homepage URL" stopProcessing="true">
          <match url="^$" />
          <action type="Rewrite" url="index.cfm" appendQueryString="true" />
        </rule>
        <rule name="Rewrite clean profile URL" stopProcessing="true">
          <match url="^flavio-di-virgilio/?$" ignoreCase="true" />
          <action type="Rewrite" url="flavio-di-virgilio.cfm" appendQueryString="true" />
        </rule>
        <rule name="Rewrite clean ColdFusion development URL" stopProcessing="true">
          <match url="^coldfusion-development/?$" ignoreCase="true" />
          <action type="Rewrite" url="coldfusion-development.cfm" appendQueryString="true" />
        </rule>
        <rule name="Rewrite clean SEO AI readiness URL" stopProcessing="true">
          <match url="^seo-ai-readiness/?$" ignoreCase="true" />
          <action type="Rewrite" url="seo-ai-readiness.cfm" appendQueryString="true" />
        </rule>
        <rule name="Redirect tools landing CFM URL to clean URL" stopProcessing="true">
          <match url="^tools\.cfm$" ignoreCase="true" />
          <action type="Redirect" url="/tools" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <rule name="Redirect tool CFM URLs to clean URLs" stopProcessing="true">
          <match url="^tools/([a-z0-9-]+)\.cfm$" ignoreCase="true" />
          <action type="Redirect" url="/tools/{R:1}" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <!-- The section landing page has a physical /tools directory, so it needs its own route. -->
        <rule name="Rewrite clean tools landing URL" stopProcessing="true">
          <match url="^tools/?$" ignoreCase="true" />
          <action type="Rewrite" url="tools.cfm" appendQueryString="true" />
        </rule>
        <!-- Internally route /tools/slug to the existing CFML entry point. -->
        <rule name="Rewrite clean tool URLs" stopProcessing="true">
          <match url="^tools/([a-z0-9-]+)/?$" ignoreCase="true" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="tools/{R:1}.cfm" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
    <httpErrors errorMode="Custom" existingResponse="PassThrough">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404" responseMode="ExecuteURL" />
    </httpErrors>
    <staticContent>
      <mimeMap fileExtension=".geojson" mimeType="application/geo+json" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>
  </system.webServer>
</configuration>
