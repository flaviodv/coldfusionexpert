<div class="tool-widget widget-uuid-generator"><label for="uuid-count"><cfif local.isEs>Cantidad (1 a 20)<cfelse>Quantity (1 to 20)</cfif></label><input id="uuid-count" type="number" min="1" max="20" value="1"><button type="button" class="btn-social btn-upwork" id="uuid-run"><i class="fas fa-fingerprint"></i> <cfif local.isEs>Generar<cfelse>Generate</cfif></button><textarea id="uuid-output" rows="8" readonly spellcheck="false"></textarea><button type="button" class="tool-copy" data-copy-target="uuid-output"><i class="far fa-copy"></i> <cfif local.isEs>Copiar<cfelse>Copy</cfif></button></div>
<script>
(function(){document.getElementById('uuid-run').addEventListener('click',function(){var n=Math.max(1,Math.min(20,parseInt(document.getElementById('uuid-count').value,10)||1)),out=[];for(var i=0;i<n;i++)out.push(crypto.randomUUID?crypto.randomUUID():'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g,function(c){var r=crypto.getRandomValues(new Uint8Array(1))[0]&15,v=c==='x'?r:(r&3|8);return v.toString(16);}));document.getElementById('uuid-output').value=out.join('\n');});}());
</script>
