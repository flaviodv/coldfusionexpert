    <div><label for="appcfc-engine"><cfif local.isEs>Motor CFML<cfelse>CFML engine</cfif></label><select id="appcfc-engine"><option value="Lucee">Lucee</option><option value="Adobe ColdFusion">Adobe ColdFusion</option></select></div>
