    <div><label for="appcfc-name"><cfif local.isEs>Nombre de la aplicación<cfelse>Application name</cfif></label><input id="appcfc-name" value="MyApplication" placeholder="MyApplication"></div>
    <div><label for="appcfc-application-timeout"><cfif local.isEs>Timeout de aplicación (minutos)<cfelse>Application timeout (minutes)</cfif></label><input id="appcfc-application-timeout" type="number" min="1" value="1440"></div>
    <div><label for="appcfc-session-timeout"><cfif local.isEs>Timeout de sesión (minutos)<cfelse>Session timeout (minutes)</cfif></label><input id="appcfc-session-timeout" type="number" min="1" value="30"></div>
    <div><label for="appcfc-session-management"><cfif local.isEs>¿Habilitar sesiones?<cfelse>Enable sessions?</cfif></label><select id="appcfc-session-management"><option value="true"><cfif local.isEs>Sí<cfelse>Yes</cfif></option><option value="false"><cfif local.isEs>No<cfelse>No</cfif></option></select></div>
    <div><label for="appcfc-client"><cfif local.isEs>¿Habilitar client scope?<cfelse>Enable client scope?</cfif></label><select id="appcfc-client"><option value="false"><cfif local.isEs>No<cfelse>No</cfif></option><option value="true"><cfif local.isEs>Sí<cfelse>Yes</cfif></option></select></div>
    <div><label for="appcfc-client-cookies"><cfif local.isEs>¿Usar cookies de cliente?<cfelse>Use client cookies?</cfif></label><select id="appcfc-client-cookies"><option value="true"><cfif local.isEs>Sí<cfelse>Yes</cfif></option><option value="false"><cfif local.isEs>No<cfelse>No</cfif></option></select></div>
    <div><label for="appcfc-orm"><cfif local.isEs>¿Habilitar ORM?<cfelse>Enable ORM?</cfif></label><select id="appcfc-orm"><option value="false"><cfif local.isEs>No<cfelse>No</cfif></option><option value="true"><cfif local.isEs>Sí<cfelse>Yes</cfif></option></select></div>
    <div><label for="appcfc-datasource-general"><cfif local.isEs>Datasource general<cfelse>General datasource</cfif></label><input id="appcfc-datasource-general" placeholder="myDatasource"></div>
    <div><label for="appcfc-datasource"><cfif local.isEs>Datasource ORM<cfelse>ORM datasource</cfif></label><input id="appcfc-datasource" placeholder="myDatasource"></div>
    <div><label for="appcfc-script-protect">scriptProtect</label><input id="appcfc-script-protect" placeholder="all"></div>
    <div><label for="appcfc-secure-json"><cfif local.isEs>¿Habilitar secureJSON?<cfelse>Enable secureJSON?</cfif></label><select id="appcfc-secure-json"><option value="false"><cfif local.isEs>No<cfelse>No</cfif></option><option value="true"><cfif local.isEs>Sí<cfelse>Yes</cfif></option></select></div>
