  <p class="tool-message" id="appcfc-message" aria-live="polite"></p><label for="appcfc-output"><cfif local.isEs>Application.cfc generado<cfelse>Generated Application.cfc</cfif></label><textarea id="appcfc-output" rows="24" readonly spellcheck="false"></textarea>
</div>
