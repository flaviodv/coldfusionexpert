<div class="tool-widget widget-text-case-converter">
  <label for="text-case-input"><cfif local.isEs>Texto de entrada<cfelse>Input text</cfif></label><textarea id="text-case-input" rows="7"></textarea>
  <div class="widget-buttons"><button type="button" class="btn-social btn-upwork" data-case="upper">UPPERCASE</button><button type="button" class="btn-social btn-upwork" data-case="lower">lowercase</button><button type="button" class="btn-social btn-upwork" data-case="title">Title Case</button><button type="button" class="btn-social btn-upwork" data-case="camel">camelCase</button><button type="button" class="btn-social btn-upwork" data-case="snake">snake_case</button><button type="button" class="btn-social btn-upwork" data-case="kebab">kebab-case</button></div>
  <label for="text-case-output"><cfif local.isEs>Resultado<cfelse>Result</cfif></label><textarea id="text-case-output" rows="7" readonly></textarea><button type="button" class="tool-copy" data-copy-target="text-case-output"><i class="far fa-copy"></i> <cfif local.isEs>Copiar<cfelse>Copy</cfif></button>
</div>
<script>
(function(){var input=document.getElementById('text-case-input'),out=document.getElementById('text-case-output');function words(s){return s.trim().replace(/([a-z])([A-Z])/g,'$1 $2').split(/[^\p{L}\p{N}]+/u).filter(Boolean);}document.querySelectorAll('[data-case]').forEach(function(b){b.addEventListener('click',function(){var s=input.value,w=words(s),type=b.dataset.case;if(type==='upper')out.value=s.toUpperCase();else if(type==='lower')out.value=s.toLowerCase();else if(type==='title')out.value=w.map(function(x){return x.charAt(0).toUpperCase()+x.slice(1).toLowerCase();}).join(' ');else if(type==='camel')out.value=w.map(function(x,i){x=x.toLowerCase();return i?x.charAt(0).toUpperCase()+x.slice(1):x;}).join('');else out.value=w.map(function(x){return x.toLowerCase();}).join(type==='snake'?'_':'-');});});}());
</script>
