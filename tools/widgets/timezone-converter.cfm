<div class="tool-widget widget-timezone-converter">
  <div class="timezone-converter-grid">
    <div class="timezone-form-panel">
      <label for="tz-date"><cfif local.isEs>Fecha y hora de origen<cfelse>Source date and time</cfif></label><input id="tz-date" type="datetime-local">
      <label for="tz-from"><cfif local.isEs>Zona horaria de origen<cfelse>Source time zone</cfif></label><select id="tz-from"></select>
      <label for="tz-to"><cfif local.isEs>Zona horaria de destino<cfelse>Destination time zone</cfif></label><select id="tz-to"></select>
      <div class="timezone-result-card" id="tz-result" aria-live="polite">
        <span class="timezone-result-label"><cfif local.isEs>Hora en destino<cfelse>Destination time</cfif></span>
        <strong id="tz-result-time">—</strong>
        <span id="tz-result-zone">—</span>
        <small id="tz-result-offset">—</small>
      </div>
    </div>
    <div class="timezone-map-panel">
      <div class="timezone-map-controls" role="group" aria-label="<cfif local.isEs>Destino del selector de mapa<cfelse>Map selection target</cfif>">
        <span><cfif local.isEs>El clic en el mapa selecciona:<cfelse>Map clicks select:</cfif></span>
        <button type="button" class="tool-copy is-active" data-tz-map-target="from"><cfif local.isEs>Zona de origen<cfelse>Source time zone</cfif></button>
        <button type="button" class="tool-copy" data-tz-map-target="to"><cfif local.isEs>Zona de destino<cfelse>Destination time zone</cfif></button>
      </div>
      <div class="timezone-map-wrap"><svg id="tz-map" viewBox="0 0 1000 500" role="img" aria-label="<cfif local.isEs>Mapa mundial de zonas horarias seleccionables<cfelse>Selectable world time zone map</cfif>"><text x="500" y="250" text-anchor="middle"><cfif local.isEs>Cargando mapa de zonas horarias…<cfelse>Loading time zone map…</cfif></text></svg></div>
      <small><cfif local.isEs>Límites aproximados: © colaboradores de OpenStreetMap, Timezone Boundary Builder (2026c).<cfelse>Approximate boundaries: © OpenStreetMap contributors, Timezone Boundary Builder (2026c).</cfif></small>
      <p class="tool-message" id="tz-map-message" aria-live="polite"></p>
    </div>
  </div>
</div>
<script>
(function(){var zones=(Intl.supportedValuesOf?Intl.supportedValuesOf('timeZone'):['UTC','America/Argentina/Buenos_Aires','America/New_York','America/Los_Angeles','Europe/London','Europe/Madrid','Europe/Paris','Asia/Tokyo','Australia/Sydney']);var from=document.getElementById('tz-from'),to=document.getElementById('tz-to'),date=document.getElementById('tz-date'),map=document.getElementById('tz-map'),mapMessage=document.getElementById('tz-map-message'),mapTarget='from',targetButtons=document.querySelectorAll('[data-tz-map-target]');zones.forEach(function(z){from.add(new Option(z,z));to.add(new Option(z,z));});var localZone=Intl.DateTimeFormat().resolvedOptions().timeZone;from.value=localZone;to.value='UTC';var now=new Date();now.setMinutes(now.getMinutes()-now.getTimezoneOffset());date.value=now.toISOString().slice(0,16);function offsetAt(instant,zone){var p=new Intl.DateTimeFormat('en-US',{timeZone:zone,year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit',hourCycle:'h23'}).formatToParts(instant).reduce(function(a,x){a[x.type]=x.value;return a;},{});return Date.UTC(p.year,p.month-1,p.day,p.hour,p.minute,p.second)-instant.getTime();}function setMapTarget(target){mapTarget=target;targetButtons.forEach(function(item){item.classList.toggle('is-active',item.dataset.tzMapTarget===target);});}function convert(){if(!date.value||!from.value||!to.value)return;var p=date.value.match(/(\d+)-(\d+)-(\d+)T(\d+):(\d+)/),wall=Date.UTC(+p[1],+p[2]-1,+p[3],+p[4],+p[5]),utc=wall-offsetAt(new Date(wall),from.value);utc=wall-offsetAt(new Date(utc),from.value);var instant=new Date(utc),display=new Intl.DateTimeFormat('<cfif local.isEs>es-AR<cfelse>en-US</cfif>',{timeZone:to.value,dateStyle:'full',timeStyle:'short'}).format(instant),difference=(offsetAt(instant,to.value)-offsetAt(instant,from.value))/3600000,absolute=Math.abs(difference),unit=absolute===1?'<cfif local.isEs>hora<cfelse>hour</cfif>':'<cfif local.isEs>horas<cfelse>hours</cfif>';document.getElementById('tz-result-time').textContent=display;document.getElementById('tz-result-zone').textContent=to.value;document.getElementById('tz-result-offset').textContent=difference===0?'<cfif local.isEs>Misma hora que el origen<cfelse>Same time as the source</cfif>':absolute+' '+unit+' '+(difference>0?'<cfif local.isEs>adelante<cfelse>ahead</cfif>':'<cfif local.isEs>atrás<cfelse>behind</cfif>')+' <cfif local.isEs>respecto del origen<cfelse>from the source</cfif>';}[date,from,to].forEach(function(control){control.addEventListener(control===date?'input':'change',convert);});targetButtons.forEach(function(button){button.addEventListener('click',function(){setMapTarget(button.dataset.tzMapTarget);});});function project(point){return [(point[0]+180)/360*1000,(90-point[1])/180*500];}function ringPath(ring){return ring.map(function(point,index){var xy=project(point);return (index?'L':'M')+xy[0].toFixed(2)+' '+xy[1].toFixed(2);}).join(' ')+'Z';}function geometryPath(geometry){var polygons=geometry.type==='Polygon'?[geometry.coordinates]:geometry.coordinates;return polygons.map(function(polygon){return polygon.map(ringPath).join('');}).join('');}function colorFor(zone){var hash=0;for(var i=0;i<zone.length;i++)hash=(hash*31+zone.charCodeAt(i))>>>0;return 'hsl('+(hash%360)+', 56%, 64%)';}function selectZone(zone){var selectedTarget=mapTarget,target=selectedTarget==='from'?from:to;if(!Array.prototype.some.call(target.options,function(option){return option.value===zone;}))target.add(new Option(zone,zone));target.value=zone;mapMessage.className='tool-message';mapMessage.textContent='<cfif local.isEs>Seleccionada: <cfelse>Selected: </cfif>'+zone+' ('+(selectedTarget==='from'?'<cfif local.isEs>origen<cfelse>source</cfif>':'<cfif local.isEs>destino<cfelse>destination</cfif>')+')';convert();if(selectedTarget==='from')setMapTarget('to');}fetch('/assets/data/timezones-simplified.geojson').then(function(response){if(!response.ok)throw new Error();return response.json();}).then(function(data){map.innerHTML='';var fragment=document.createDocumentFragment();data.features.forEach(function(feature){var zone=feature.properties.tzid,path=document.createElementNS('http://www.w3.org/2000/svg','path');path.setAttribute('d',geometryPath(feature.geometry));path.setAttribute('fill',colorFor(zone));path.setAttribute('data-zone',zone);path.setAttribute('tabindex','0');path.setAttribute('role','button');path.setAttribute('aria-label',zone);path.addEventListener('click',function(){selectZone(zone);});path.addEventListener('keydown',function(event){if(event.key==='Enter'||event.key===' '){event.preventDefault();selectZone(zone);}});fragment.appendChild(path);});map.appendChild(fragment);}).catch(function(){mapMessage.className='tool-message is-error';mapMessage.textContent='<cfif local.isEs>No se pudo cargar el mapa. Podés usar los selectores de zonas horarias.<cfelse>The map could not be loaded. You can still use the time zone selectors.</cfif>';});convert();}());
</script>
