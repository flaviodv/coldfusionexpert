<div class="tool-widget widget-http-status-codes"><label for="http-status-search"><cfif local.isEs>Buscar por código, nombre o descripción<cfelse>Search by code, name or description</cfif></label><input id="http-status-search" type="search" autocomplete="off"><div class="http-status-table-wrap"><table><thead><tr><th><cfif local.isEs>Código<cfelse>Code</cfif></th><th><cfif local.isEs>Nombre<cfelse>Name</cfif></th><th><cfif local.isEs>Descripción<cfelse>Description</cfif></th></tr></thead><tbody id="http-status-body"></tbody></table></div><p class="tool-message" id="http-status-empty" hidden><cfif local.isEs>No se encontraron códigos.<cfelse>No status codes found.</cfif></p></div>
<script>
(function(){var es=<cfif local.isEs>true<cfelse>false</cfif>,data=[[100,'Continue','Continue'],[101,'Switching Protocols','Cambio de protocolos'],[200,'OK','Solicitud exitosa'],[201,'Created','Recurso creado'],[204,'No Content','Sin contenido'],[301,'Moved Permanently','Redirección permanente'],[302,'Found','Redirección temporal'],[304,'Not Modified','Sin cambios'],[400,'Bad Request','Solicitud incorrecta'],[401,'Unauthorized','Autenticación requerida'],[403,'Forbidden','Acceso denegado'],[404,'Not Found','Recurso no encontrado'],[405,'Method Not Allowed','Método no permitido'],[408,'Request Timeout','Tiempo de espera agotado'],[409,'Conflict','Conflicto'],[418,"I'm a teapot",'Soy una tetera'],[422,'Unprocessable Content','Contenido no procesable'],[429,'Too Many Requests','Demasiadas solicitudes'],[500,'Internal Server Error','Error interno del servidor'],[501,'Not Implemented','No implementado'],[502,'Bad Gateway','Puerta de enlace incorrecta'],[503,'Service Unavailable','Servicio no disponible'],[504,'Gateway Timeout','Tiempo de espera de puerta de enlace']];var body=document.getElementById('http-status-body'),empty=document.getElementById('http-status-empty');function render(q){q=q.toLowerCase();var rows=data.filter(function(x){return x.join(' ').toLowerCase().indexOf(q)>-1;});body.innerHTML=rows.map(function(x){return '<tr><td>'+x[0]+'</td><td>'+x[1]+'</td><td>'+(es?x[2]:x[1]===x[2]?'Successful response':x[1]+' response')+'</td></tr>';}).join('');empty.hidden=rows.length>0;}document.getElementById('http-status-search').addEventListener('input',function(){render(this.value);});render('');}());
</script>
