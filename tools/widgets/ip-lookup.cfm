<div class="tool-widget widget-ip-lookup">
  <p><cfif local.isEs>Consultá tu dirección IP pública, ubicación aproximada y datos del navegador.<cfelse>Check your public IP address, approximate location, and browser details.</cfif></p>
  <button type="button" class="btn-social btn-upwork" id="ip-lookup-run"><i class="fas fa-search"></i> <cfif local.isEs>Consultar mi IP<cfelse>Look up my IP</cfif></button>
  <p class="tool-message" id="ip-lookup-message" aria-live="polite"></p>
  <div id="ip-lookup-results" hidden>
    <label><cfif local.isEs>IP pública<cfelse>Public IP</cfif><input id="ip-public" readonly></label>
    <label><cfif local.isEs>Ubicación aproximada<cfelse>Approximate location</cfif><input id="ip-location" readonly></label>
    <label><cfif local.isEs>Proveedor / red<cfelse>Provider / network</cfif><input id="ip-network" readonly></label>
    <label>User-Agent<textarea id="ip-user-agent" rows="3" readonly></textarea></label>
    <label><cfif local.isEs>Cabeceras visibles del navegador<cfelse>Browser-visible headers</cfif><textarea id="ip-headers" rows="6" readonly></textarea></label>
  </div>
  <hr>
  <label for="ip-domain-input"><cfif local.isEs>IP, URL o dominio para resolver<cfelse>IP address, URL, or domain to resolve</cfif></label>
  <input id="ip-domain-input" type="text" inputmode="url" placeholder="1.1.1.1, example.com o https://example.com/path">
  <button type="button" class="btn-social btn-upwork" id="ip-domain-run"><i class="fas fa-search"></i> <cfif local.isEs>Consultar dominio o IP<cfelse>Look up domain or IP</cfif></button>
  <p class="tool-message" id="ip-domain-message" aria-live="polite"></p>
  <div id="ip-dns-results"><label for="ip-domain-result"><cfif local.isEs>Registros IPv4 encontrados<cfelse>IPv4 records found</cfif></label><textarea id="ip-domain-result" rows="3" readonly spellcheck="false"></textarea>
  <small><cfif local.isEs>La consulta usa DNS-over-HTTPS. Si el sitio usa CDN o proxy, la IP puede corresponder a esa red y no al servidor de origen.<cfelse>This lookup uses DNS-over-HTTPS. If the site uses a CDN or proxy, the IP may belong to that network rather than the origin server.</cfif></small></div>
  <div class="ip-rdap-card" id="ip-rdap-card" hidden>
    <h3><i class="fas fa-id-card"></i> <cfif local.isEs>Información de registro (RDAP)<cfelse>Registration information (RDAP)</cfif></h3>
    <dl>
      <div><dt><cfif local.isEs>Dominio registrado<cfelse>Registered domain</cfif></dt><dd id="ip-rdap-domain">—</dd></div>
      <div><dt><cfif local.isEs>Registrador<cfelse>Registrar</cfif></dt><dd id="ip-rdap-registrar">—</dd></div>
      <div><dt><cfif local.isEs>Fecha de alta<cfelse>Registration date</cfif></dt><dd id="ip-rdap-created">—</dd></div>
      <div><dt><cfif local.isEs>Vencimiento<cfelse>Expiration date</cfif></dt><dd id="ip-rdap-expires">—</dd></div>
      <div><dt>Nameservers</dt><dd id="ip-rdap-nameservers">—</dd></div>
      <div><dt><cfif local.isEs>Estados<cfelse>Status</cfif></dt><dd id="ip-rdap-status">—</dd></div>
    </dl>
    <p class="tool-message" id="ip-rdap-message" aria-live="polite"></p>
  </div>
  <div class="ip-rdap-card" id="ip-address-card" hidden>
    <h3><i class="fas fa-map-marker-alt"></i> <cfif local.isEs>Información de dirección IP<cfelse>IP address information</cfif></h3>
    <dl>
      <div><dt>IP</dt><dd id="ip-address-value">—</dd></div>
      <div><dt><cfif local.isEs>Ubicación aproximada<cfelse>Approximate location</cfif></dt><dd id="ip-address-location">—</dd></div>
      <div><dt><cfif local.isEs>País<cfelse>Country</cfif></dt><dd id="ip-address-country">—</dd></div>
      <div><dt><cfif local.isEs>Proveedor / red<cfelse>Provider / network</cfif></dt><dd id="ip-address-network">—</dd></div>
      <div><dt>ASN</dt><dd id="ip-address-asn">—</dd></div>
      <div><dt><cfif local.isEs>Zona horaria<cfelse>Time zone</cfif></dt><dd id="ip-address-timezone">—</dd></div>
    </dl>
    <p class="tool-message" id="ip-address-message" aria-live="polite"></p>
  </div>
</div>
<script>
(function(){var run=document.getElementById('ip-lookup-run'),msg=document.getElementById('ip-lookup-message'),results=document.getElementById('ip-lookup-results'),domainInput=document.getElementById('ip-domain-input'),domainRun=document.getElementById('ip-domain-run'),domainMessage=document.getElementById('ip-domain-message'),domainResult=document.getElementById('ip-domain-result');run.addEventListener('click',function(){msg.className='tool-message';msg.textContent='<cfif local.isEs>Consultando…<cfelse>Looking up…</cfif>';fetch('https://ipwho.is/').then(function(r){if(!r.ok)throw new Error();return r.json();}).then(function(d){if(d.success===false)throw new Error();var connection=d.connection||{};document.getElementById('ip-public').value=d.ip||'';document.getElementById('ip-location').value=[d.city,d.region,d.country].filter(Boolean).join(', ');document.getElementById('ip-network').value=[connection.org,connection.asn].filter(Boolean).join(' · ');document.getElementById('ip-user-agent').value=navigator.userAgent;document.getElementById('ip-headers').value='Language: '+navigator.language+'\nPlatform: '+(navigator.platform||'')+'\nTimezone: '+Intl.DateTimeFormat().resolvedOptions().timeZone+'\nReferrer: '+(document.referrer||'<cfif local.isEs>Sin referrer<cfelse>No referrer</cfif>');results.hidden=false;msg.textContent='';}).catch(function(){msg.className='tool-message is-error';msg.textContent='<cfif local.isEs>No se pudo consultar la IP. Intentá nuevamente más tarde.<cfelse>Could not look up the IP. Please try again later.</cfif>';});});domainRun.addEventListener('click',function(){var raw=domainInput.value.trim(),host;if(!raw){domainMessage.className='tool-message is-error';domainMessage.textContent='<cfif local.isEs>Ingresá una URL o dominio.<cfelse>Enter a URL or domain.</cfif>';return;}try{host=new URL(/^[a-z][a-z0-9+.-]*:\/\//i.test(raw)?raw:'https://'+raw).hostname;}catch(error){domainMessage.className='tool-message is-error';domainMessage.textContent='<cfif local.isEs>La URL no es válida.<cfelse>The URL is not valid.</cfif>';return;}if(/^\d{1,3}(?:\.\d{1,3}){3}$/.test(host)){domainResult.value=host;domainMessage.className='tool-message';domainMessage.textContent='<cfif local.isEs>Ya ingresaste una dirección IP.<cfelse>You entered an IP address already.</cfif>';return;}domainMessage.className='tool-message';domainMessage.textContent='<cfif local.isEs>Consultando DNS…<cfelse>Querying DNS…</cfif>';fetch('https://cloudflare-dns.com/dns-query?name='+encodeURIComponent(host)+'&type=A',{headers:{Accept:'application/dns-json'}}).then(function(response){if(!response.ok)throw new Error();return response.json();}).then(function(data){var addresses=(data.Answer||[]).filter(function(answer){return answer.type===1;}).map(function(answer){return answer.data;});if(!addresses.length)throw new Error();domainResult.value=addresses.join('\n');domainMessage.className='tool-message';domainMessage.textContent=host+' · '+addresses.length+' <cfif local.isEs>registro(s) IPv4 encontrado(s).<cfelse>IPv4 record(s) found.</cfif>';}).catch(function(){domainResult.value='';domainMessage.className='tool-message is-error';domainMessage.textContent='<cfif local.isEs>No se encontraron registros IPv4 o no se pudo consultar el DNS.<cfelse>No IPv4 records were found or DNS could not be queried.</cfif>';});});}());
</script>
<script>
(function(){var input=document.getElementById('ip-domain-input'),button=document.getElementById('ip-domain-run'),dns=document.getElementById('ip-dns-results'),rdap=document.getElementById('ip-rdap-card'),card=document.getElementById('ip-address-card'),message=document.getElementById('ip-address-message');function hostFromInput(raw){return new URL(/^[a-z][a-z0-9+.-]*:\/\//i.test(raw)?raw:'https://'+raw).hostname;}function fill(id,value){document.getElementById(id).textContent=value||'—';}button.addEventListener('click',function(){var raw=input.value.trim(),host;if(!raw)return;try{host=hostFromInput(raw);}catch(error){return;}if(!/^\d{1,3}(?:\.\d{1,3}){3}$/.test(host)){card.hidden=true;dns.hidden=false;return;}dns.hidden=true;rdap.hidden=true;card.hidden=false;message.className='tool-message is-loading';message.textContent='<cfif local.isEs>Buscando información de región y red…<cfelse>Looking up region and network information…</cfif>';fetch('https://ipwho.is/'+encodeURIComponent(host)).then(function(response){if(!response.ok)throw new Error();return response.json();}).then(function(data){if(data.success===false)throw new Error();var connection=data.connection||{},timezone=data.timezone||{};fill('ip-address-value',data.ip||host);fill('ip-address-location',[data.city,data.region].filter(Boolean).join(', '));fill('ip-address-country',data.country);fill('ip-address-network',connection.org);fill('ip-address-asn',connection.asn);fill('ip-address-timezone',timezone.id);message.className='tool-message';message.textContent='';}).catch(function(){message.className='tool-message is-error';message.textContent='<cfif local.isEs>No se pudo obtener información de esta dirección IP.<cfelse>Could not get information for this IP address.</cfif>';});});}());
</script>
<script>
(function(){var input=document.getElementById('ip-domain-input'),button=document.getElementById('ip-domain-run'),card=document.getElementById('ip-rdap-card'),message=document.getElementById('ip-rdap-message');function hostFromInput(raw){return new URL(/^[a-z][a-z0-9+.-]*:\/\//i.test(raw)?raw:'https://'+raw).hostname;}function registeredDomain(host){var parts=host.split('.'),threePart=['com.ar','com.br','com.mx','com.au','co.uk','org.uk','gov.uk','co.nz'];if(parts.length>2&&threePart.indexOf(parts.slice(-2).join('.'))!==-1)return parts.slice(-3).join('.');return parts.slice(-2).join('.');}function vcardName(entity){var items=(entity.vcardArray&&entity.vcardArray[1])||[],name=items.filter(function(item){return item[0]==='fn';})[0];return name?name[3]:'';}function eventDate(data,action){var event=(data.events||[]).filter(function(item){return item.eventAction===action;})[0];return event&&event.eventDate?new Date(event.eventDate).toLocaleDateString('<cfif local.isEs>es-AR<cfelse>en-US</cfif>'):'—';}function fill(id,value){document.getElementById(id).textContent=value||'—';}button.addEventListener('click',function(){var raw=input.value.trim(),host,domain;if(!raw)return;try{host=hostFromInput(raw);}catch(error){return;}if(/^\d{1,3}(?:\.\d{1,3}){3}$/.test(host))return;domain=registeredDomain(host);card.hidden=false;message.className='tool-message is-loading';message.textContent='<cfif local.isEs>Buscando información de registro…<cfelse>Looking up registration information…</cfif>';fetch('https://rdap.org/domain/'+encodeURIComponent(domain)).then(function(response){if(!response.ok)throw new Error();return response.json();}).then(function(data){var registrar=(data.entities||[]).filter(function(entity){return (entity.roles||[]).indexOf('registrar')!==-1;})[0];fill('ip-rdap-domain',data.ldhName||domain);fill('ip-rdap-registrar',registrar?vcardName(registrar):'');fill('ip-rdap-created',eventDate(data,'registration'));fill('ip-rdap-expires',eventDate(data,'expiration'));fill('ip-rdap-nameservers',(data.nameservers||[]).map(function(item){return item.ldhName;}).filter(Boolean).join(', '));fill('ip-rdap-status',(data.status||[]).join(', '));message.className='tool-message';message.textContent='';}).catch(function(){card.hidden=false;message.className='tool-message is-error';message.textContent='<cfif local.isEs>No se pudieron obtener datos RDAP para este dominio. Algunos dominios o registros privados no los publican.<cfelse>RDAP data could not be obtained for this domain. Some domains or private registrations do not publish it.</cfif>';});});}());
</script>
