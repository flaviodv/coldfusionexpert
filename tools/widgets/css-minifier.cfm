<div class="tool-widget widget-css-minifier">
  <label for="css-minifier-input"><cfif local.isEs>CSS de entrada<cfelse>Input CSS</cfif></label>
  <textarea id="css-minifier-input" rows="10" spellcheck="false" placeholder="body { color: #333; }"></textarea>
  <div class="widget-file-actions"><label class="tool-file-label" for="css-minifier-file"><i class="fas fa-upload"></i> <cfif local.isEs>Subir archivo CSS<cfelse>Upload CSS file</cfif></label><input type="file" id="css-minifier-file" accept=".css,text/css"></div>
  <div class="widget-buttons"><button type="button" class="btn-social btn-upwork" id="css-minifier-run"><i class="fas fa-compress-alt"></i> <cfif local.isEs>Minificar<cfelse>Minify</cfif></button><button type="button" class="btn-social btn-upwork" id="css-formatter-run"><i class="fas fa-align-left"></i> <cfif local.isEs>Formatear<cfelse>Format</cfif></button></div>
  <p class="tool-message" id="css-minifier-message" aria-live="polite"></p>
  <label for="css-minifier-output"><cfif local.isEs>Resultado<cfelse>Result</cfif></label>
  <textarea id="css-minifier-output" rows="8" readonly spellcheck="false"></textarea>
  <button type="button" class="tool-copy" data-copy-target="css-minifier-output"><i class="far fa-copy"></i> <cfif local.isEs>Copiar<cfelse>Copy</cfif></button><button type="button" class="tool-copy" id="css-minifier-download"><i class="fas fa-download"></i> <cfif local.isEs>Descargar CSS<cfelse>Download CSS</cfif></button>
</div>
<script>
(function () { var input=document.getElementById('css-minifier-input'), output=document.getElementById('css-minifier-output'), message=document.getElementById('css-minifier-message'), fileName='styles'; function location(pos){var before=input.value.slice(0,pos),lines=before.split(/\r?\n/);return '<cfif local.isEs>Línea <cfelse>Line </cfif>'+lines.length+', <cfif local.isEs>columna <cfelse>column </cfif>' +(lines[lines.length-1].length+1);} function validate(css){var stack=[],quote='',comment=false;for(var p=0;p<css.length;p++){var ch=css[p],next=css[p+1];if(comment){if(ch==='*'&&next==='/'){comment=false;p++;}continue;}if(!quote&&ch==='/'&&next==='*'){comment=true;p++;continue;}if(ch==='\\'&&quote){p++;continue;}if(ch==='"'||ch==="'"){if(!quote)quote=ch;else if(quote===ch)quote='';continue;}if(quote)continue;if(ch==='{')stack.push(p);if(ch==='}'){if(!stack.length)return {pos:p,text:'<cfif local.isEs>Llave de cierre sin apertura.<cfelse>Closing brace without an opening brace.</cfif>'};stack.pop();}}if(comment)return {pos:css.length,text:'<cfif local.isEs>Comentario sin cerrar.<cfelse>Unclosed comment.</cfif>'};if(quote)return {pos:css.length,text:'<cfif local.isEs>Cadena sin cerrar.<cfelse>Unclosed string.</cfif>'};if(stack.length)return {pos:stack.pop(),text:'<cfif local.isEs>Llave de apertura sin cierre.<cfelse>Opening brace without a closing brace.</cfif>'};return null;} function process(mode){var error=validate(input.value);if(error){output.value='';message.textContent='<cfif local.isEs>Error de CSS: <cfelse>CSS error: </cfif>'+error.text+' '+location(error.pos);message.className='tool-message is-error';return;}var compact=input.value.replace(/\/\*[\s\S]*?\*\//g,'').replace(/\s+/g,' ').replace(/\s*([{}:;,])\s*/g,'$1').replace(/;}/g,'}').trim();if(mode==='format'){var level=0;output.value=compact.replace(/\{/g,function(){return ' {\n'+ '  '.repeat(++level);}).replace(/;/g,function(){return ';\n'+'  '.repeat(level);}).replace(/\}/g,function(){return '\n'+'  '.repeat(--level)+'}\n'+'  '.repeat(level);}).replace(/\n\s*\n/g,'\n').trim();message.textContent='<cfif local.isEs>CSS válido y formateado.<cfelse>CSS is valid and formatted.</cfif>';}else{output.value=compact;message.textContent='<cfif local.isEs>CSS válido y minificado.<cfelse>CSS is valid and minified.</cfif>';}message.className='tool-message';} document.getElementById('css-minifier-run').addEventListener('click',function(){process('minify');});document.getElementById('css-formatter-run').addEventListener('click',function(){process('format');});document.getElementById('css-minifier-file').addEventListener('change',function(){var file=this.files[0];if(!file)return;fileName=file.name.replace(/\.css$/i,'')||'styles';var reader=new FileReader();reader.onload=function(){input.value=reader.result;process('minify');};reader.readAsText(file);});document.getElementById('css-minifier-download').addEventListener('click',function(){if(!output.value)return;var a=document.createElement('a');a.href=URL.createObjectURL(new Blob([output.value],{type:'text/css'}));a.download=fileName+'.min.css';a.click();URL.revokeObjectURL(a.href);}); }());
</script>
